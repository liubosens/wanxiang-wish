page {
  min-height: 100vh;
  background: radial-gradient(120% 80% at 50% -10%, #1e3a5f 0%, #0b1220 55%, #070b14 100%);
  color: #e8eefc;
  font-size: 28rpx;
  box-sizing: border-box;
}

.card {
  margin: 24rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(125, 211, 252, 0.18);
}

.btn-primary {
  background: linear-gradient(135deg, #38bdf8, #818cf8);
  color: #0b1220;
  font-weight: 600;
  border-radius: 999rpx;
}

.btn-ghost {
  background: transparent;
  color: #7dd3fc;
  border: 1rpx solid rgba(125, 211, 252, 0.45);
  border-radius: 999rpx;
}

.muted {
  color: #8b93a7;
  font-size: 24rpx;
}

.rarity-SSR { color: #fbbf24; }
.rarity-SR { color: #c084fc; }
.rarity-R { color: #94a3b8; }
