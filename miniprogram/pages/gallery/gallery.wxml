<view class="hero card">
  <view class="brand">万象祈愿</view>
  <view class="tagline">概率博物馆 · MVP</view>
  <view class="wallet muted">
    祈愿石 {{wallet.wish_stone}} · 箱钥 {{wallet.chest_key}} · 机台币 {{wallet.machine_coin}}
  </view>
</view>

<view class="card" wx:for="{{scenes}}" wx:key="id" bindtap="go" data-url="{{item.url}}">
  <view class="scene-title">{{item.title}}</view>
  <view class="muted">{{item.desc}}</view>
</view>

<button class="btn-ghost rates" bindtap="goRates">查看概率公示</button>
