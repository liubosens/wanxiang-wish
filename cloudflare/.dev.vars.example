# Copy this file to .dev.vars and fill in the values for LOCAL development only.
# .dev.vars is gitignored and must never be committed.
#
# JWT_SECRET: a long random string used to sign HS256 JWTs.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars-hex

# For production use `wrangler secret put JWT_SECRET` instead of .dev.vars.
