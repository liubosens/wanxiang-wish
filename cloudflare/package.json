{
  "name": "wanxiang-wish",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "万象祈愿 服务端权威后端 - Cloudflare Workers + D1 + KV + Hono",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 execute wanxiang-wish --local --file=./migrations/0001_init.sql",
    "migrate:remote": "wrangler d1 execute wanxiang-wish --remote --file=./migrations/0001_init.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.2024.11.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.131.0"
  }
}
